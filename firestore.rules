rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidCustomerAccount(data) {
      return data.keys().hasAll(['uid', 'provider', 'displayName']) &&
        data.keys().hasOnly(['uid', 'provider', 'displayName', 'email', 'phone', 'telegramUsername', 'photoURL']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.provider is string && (data.provider == 'google' || data.provider == 'telegram') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('telegramUsername' in data) || (data.telegramUsername is string && data.telegramUsername.size() <= 80)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    match /customer_accounts/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list: if false;
      allow create: if isOwner(uid) &&
        request.auth.token.email_verified == true &&
        isValidId(uid) &&
        isValidCustomerAccount(incoming());
      allow update: if isOwner(uid) &&
        request.auth.token.email_verified == true &&
        isValidId(uid) &&
        isValidCustomerAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'telegramUsername', 'photoURL']);
      allow delete: if false;
    }
  }
}
